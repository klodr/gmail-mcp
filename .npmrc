# Enforce engines.node locally: `npm install` on a Node older than the
# declared floor fails immediately instead of warning. Without this the
# engines field is metadata only.
#
# The floor (24.18.1) is the latest Node 24.x security release; older
# patch releases (24.0.0 → 24.18.0) miss at least one advisory fix and
# we want to refuse them outright rather than warn on. Node 24 is the
# floor the official MCP reference servers declare (engines >=24).
engine-strict=true
